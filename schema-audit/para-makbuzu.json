  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Para makbuzu ile tahsilat makbuzu aynı şey midir?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Benzer amaçlarla kullanılsalar da kullanım alanları farklıdır. Para makbuzu para teslimlerini kayıt altına almak için kullanılırken, tahsilat makbuzu yapılan ödeme veya tahsilat işlemini belgelemek amacıyla düzenlenir."
        }
      },
      {
        "@type": "Question",
        "name": "Para makbuzu resmi evrak mıdır?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Para makbuzu resmi mali fatura veya e-Fatura niteliğinde değildir. Ancak ödeme ve para teslim işlemlerinin kayıt altına alınmasında kullanılan yazılı bir ticari belgedir."
        }
      },
      {
        "@type": "Question",
        "name": "Para makbuzu baskısında minimum sipariş miktarı nedir?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Para makbuzu baskılarında minimum sipariş miktarı 5 cilttir. Her cilt kendinden kopyalı 50 takımdan oluşur."
        }
      },
      {
        "@type": "Question",
        "name": "Para makbuzuna firma logosu basılabilir mi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet, para makbuzlarına firma logosu, iletişim bilgileri, adres ve IBAN bilgileri ücretsiz grafik mizanpaj desteğimizle eklenebilmektedir."
        }
      },
      {
        "@type": "Question",
        "name": "Para makbuzu kaç nüsha basılabilir?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "En çok tercih edilen seçenekler 1 Asıl + 1 Suret (2 nüsha), 1 Asıl + 2 Suret (3 nüsha) ve 1 Asıl + 3 Suret (4 nüsha) şeklindedir."
        }
      },
      {
        "@type": "Question",
        "name": "Para makbuzu numaratörlü olmak zorunda mıdır?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Zorunlu değildir ancak evrak takibi, kayıpların önlenmesi ve arşiv düzeni açısından numaratörlü baskı standart olarak sunulmaktadır."
        }
      },
      {
        "@type": "Question",
        "name": "Özel tasarım para makbuzu yaptırabilir miyim?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet, işletmenizin özel tablo gereksinimlerine, kutucuk düzenine veya logo renklerine uygun özel mizanpaj hazırlanabilmektedir."
        }
      },
      {
        "@type": "Question",
        "name": "Para makbuzu ölçüleri değiştirilebilir mi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standart ebat 14 × 20 cm'dir. Talebe göre 10 × 14 cm (küçük boy) veya A4 (20.5 × 28.5 cm) özel ebatlarda da imalat yapılmaktadır."
        }
      },
      {
        "@type": "Question",
        "name": "İstanbul dışına gönderim yapıyor musunuz?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet, İstanbul Topkapı tesisimizde üretilen para makbuzları Türkiye'nin 81 iline kargo ile ulaştırılmaktadır."
        }
      },
      {
        "@type": "Question",
        "name": "Para makbuzu kaç günde basılır?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Grafik tasarım onayının ardından para makbuzu baskıları genellikle 3–5 iş günü içerisinde tamamlanarak kargoya teslim edilmektedir."
        }
      }
    ]
