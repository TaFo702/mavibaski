{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-sector-image-manifest.mjs",
    "prebuild": "node scripts/generate-sector-image-manifest.mjs",
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/prerender.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:routes": "npx tsx validate-all-routes.ts",
    "validate:cities": "npx tsx validate-content-uniqueness.ts",
    "validate:sitemap": "npx tsx validate-sitemap-quality.ts",
    "validate:schema": "npx tsx validate-jsonld-ownership.ts",
    "validate:metadata": "npx tsx validate-metadata-quality.ts",
    "validate:links": "npx tsx validate-internal-links.ts",
    "validate:content": "npx tsx validate-content-uniqueness.ts",
    "validate:http": "npx tsx validate-production-http.ts",
    "validate:mutations": "npx tsx validate-controlled-mutations.ts",
    "validate:spinner": "npx tsx validate-no-infinite-spinner.ts",
    "quality": "npm run typecheck && npm run lint && npm run build && npm run validate:routes && npm run validate:sitemap && npm run validate:metadata && npm run validate:links && npm run validate:content && npm run validate:http && npm run validate:mutations && npm run validate:spinner"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "resend": "^6.10.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0"
  }
}
